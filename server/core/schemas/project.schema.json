{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "required": ["id", "path"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "agent_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adws": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "name": { "type": "string" },
          "model": { "type": "string" },
          "agents": {
            "type": "array",
            "items": { "type": "string" }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "flag", "type"],
              "properties": {
                "name": { "type": "string" },
                "flag": { "type": "string" },
                "type": { "type": "string", "enum": ["string", "number", "boolean"] },
                "label": { "type": "string" },
                "default": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "integrations": {
      "type": "array"
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "required": ["id", "path"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "agent_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adws": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "integrations": {
      "type": "array"
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

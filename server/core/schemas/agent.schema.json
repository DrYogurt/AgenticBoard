{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "current_task": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "flag", "type"],
        "properties": {
          "name": { "type": "string" },
          "flag": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "number", "boolean"] },
          "label": { "type": "string" },
          "default": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

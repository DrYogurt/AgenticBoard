{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Board",
  "type": "object",
  "required": ["title", "columns", "task_order"],
  "properties": {
    "title": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "task_order": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "updated_at": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
